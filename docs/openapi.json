{
  "openapi": "3.1.0",
  "info": {
    "title": "API de lista de tarefas - contrato da entrega inicial",
    "version": "1.0.0",
    "description": "Preparei esta proposta técnica para revisão na Issue #1. Contrato estático; não é evidência de uma API em execução. Quatro operações, uma tabela e três campos. Regras e critérios complementares em docs/especificacao_sdd.md e docs/criterios_aceitacao.md."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000",
      "description": "Endereço local previsto para a implementação"
    }
  ],
  "tags": [
    {
      "name": "Tarefas",
      "description": "Lista única compartilhada de tarefas"
    }
  ],
  "paths": {
    "/tarefas": {
      "post": {
        "tags": [
          "Tarefas"
        ],
        "operationId": "criarTarefa",
        "summary": "Cadastrar uma tarefa pendente",
        "description": "Valida e normaliza o título, gera o ID e persiste concluida=false. Títulos iguais são permitidos. Campos extras são rejeitados. JSON malformado ou corpo ausente retorna 422.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TarefaCreate"
              },
              "example": {
                "titulo": "  Estudar para o bootcamp  "
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tarefa criada e persistida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TarefaRead"
                },
                "example": {
                  "id": 1,
                  "titulo": "Estudar para o bootcamp",
                  "concluida": false
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/EntradaInvalida"
          }
        }
      },
      "get": {
        "tags": [
          "Tarefas"
        ],
        "operationId": "listarTarefas",
        "summary": "Listar todas as tarefas",
        "description": "Retorna pendentes e concluídas, em ordem crescente de ID, sem paginação ou filtros. Em banco vazio retorna 200 com [].",
        "responses": {
          "200": {
            "description": "Lista completa; pode estar vazia.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TarefaRead"
                  }
                },
                "example": [
                  {
                    "id": 1,
                    "titulo": "Estudar para o bootcamp",
                    "concluida": false
                  },
                  {
                    "id": 2,
                    "titulo": "Revisar a especificação",
                    "concluida": true
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/tarefas/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TarefaId"
        }
      ],
      "patch": {
        "tags": [
          "Tarefas"
        ],
        "operationId": "concluirTarefa",
        "summary": "Marcar uma tarefa como concluída",
        "description": "Exige somente o booleano true em concluida. Não permite reabertura nem edição de título. Repetir a conclusão válida retorna 200 com a mesma representação. Validar a entrada antes de consultar a existência do registro.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TarefaConcluir"
              },
              "example": {
                "concluida": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tarefa concluída e persistida, inclusive em repetição.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TarefaRead"
                },
                "example": {
                  "id": 1,
                  "titulo": "Estudar para o bootcamp",
                  "concluida": true
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/TarefaNaoEncontrada"
          },
          "422": {
            "$ref": "#/components/responses/EntradaInvalida"
          }
        }
      },
      "delete": {
        "tags": [
          "Tarefas"
        ],
        "operationId": "excluirTarefa",
        "summary": "Excluir uma tarefa",
        "description": "Remove tarefa pendente ou concluída. Não recebe corpo. A resposta 204 tem corpo de comprimento zero. Se o ID válido estiver ausente, inclusive em nova exclusão sem novo cadastro, retorna 404.",
        "responses": {
          "204": {
            "description": "Tarefa removida. Sem corpo de resposta."
          },
          "404": {
            "$ref": "#/components/responses/TarefaNaoEncontrada"
          },
          "422": {
            "$ref": "#/components/responses/EntradaInvalida"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "TarefaId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Inteiro positivo de 64 bits. ID inválido retorna 422; ID válido inexistente retorna 404. Não se exige sequência sem lacunas.",
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "example": 1
      }
    },
    "schemas": {
      "TarefaCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "titulo"
        ],
        "properties": {
          "titulo": {
            "type": "string",
            "description": "Remover espaços em branco das extremidades antes de persistir e validar 1 a 120 caracteres Unicode. O padrão permite espaços externos; não usar maxLength=120 no texto bruto, pois espaços externos não entram no limite.",
            "pattern": "^\\s*\\S(?:[\\s\\S]{0,118}\\S)?\\s*$",
            "x-normalization": "strip",
            "x-normalized-minLength": 1,
            "x-normalized-maxLength": 120,
            "examples": [
              "Estudar para o bootcamp",
              "  Revisar API  "
            ]
          }
        }
      },
      "TarefaConcluir": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concluida"
        ],
        "properties": {
          "concluida": {
            "type": "boolean",
            "const": true,
            "description": "Apenas o booleano JSON true; rejeitar false, números, strings e null.",
            "examples": [
              true
            ]
          }
        }
      },
      "TarefaRead": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "titulo",
          "concluida"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9223372036854775807,
            "description": "Gerado pelo banco."
          },
          "titulo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Título já normalizado, sem espaços em branco nas extremidades."
          },
          "concluida": {
            "type": "boolean",
            "description": "false na criação; true após conclusão."
          }
        },
        "examples": [
          {
            "id": 1,
            "titulo": "Estudar para o bootcamp",
            "concluida": false
          },
          {
            "id": 1,
            "titulo": "Estudar para o bootcamp",
            "concluida": true
          }
        ]
      },
      "TarefaNaoEncontrada": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string",
            "const": "Tarefa não encontrada."
          }
        }
      },
      "ErroValidacao": {
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "additionalProperties": true,
        "properties": {
          "loc": {
            "type": "array",
            "minItems": 1,
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            }
          },
          "msg": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "description": "Formato do FastAPI/Pydantic. Mensagens, ordem e campos adicionais não são fixados neste contrato."
      },
      "EntradaInvalida": {
        "type": "object",
        "required": [
          "detail"
        ],
        "additionalProperties": true,
        "properties": {
          "detail": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/ErroValidacao"
            }
          }
        }
      }
    },
    "responses": {
      "TarefaNaoEncontrada": {
        "description": "ID válido sem registro correspondente, com entrada válida.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/TarefaNaoEncontrada"
            },
            "example": {
              "detail": "Tarefa não encontrada."
            }
          }
        }
      },
      "EntradaInvalida": {
        "description": "ID, corpo ou campo inválido. Sem alteração de dados. Exemplo ilustrativo de título ausente.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/EntradaInvalida"
            },
            "example": {
              "detail": [
                {
                  "loc": [
                    "body",
                    "titulo"
                  ],
                  "msg": "Field required",
                  "type": "missing"
                }
              ]
            }
          }
        }
      }
    }
  }
}
